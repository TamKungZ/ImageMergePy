#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

# The standalone runtime bundles its private libraries; list system dependencies in control.
override_dh_shlibdeps:

override_dh_auto_install:
	install -d debian/imagemerge/opt/ImageMerge debian/imagemerge/usr/bin
	cp -a runtime/ImageMerge/. debian/imagemerge/opt/ImageMerge/
	install -m 0755 packaging/imagemerge debian/imagemerge/usr/bin/imagemerge
